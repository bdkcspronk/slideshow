# Spotify Connect speaker "Francken TV" (spotifyd). Install: see docs/setup/spotify.md.
# Part of the slideshow: starts and stops with francken-tv.service.
[Unit]
Description=Francken TV Spotify speaker
After=network-online.target sound.target
PartOf=francken-tv.service

[Service]
WorkingDirectory=%h/slideshow
ExecStart=%h/.local/bin/spotifyd --no-daemon --config-path %h/slideshow/deploy/spotifyd.conf --cache-path %h/slideshow/data/spotifyd
Restart=always
RestartSec=10

[Install]
WantedBy=francken-tv.service
